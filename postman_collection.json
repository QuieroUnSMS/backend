                  "body": "{\n  \"id\": \"00000000-0000-4000-8000-000000000010\",\n  \"registration_status\": \"registered\",\n  \"email\": \"buyer@example.com\",\n  \"phone_e164\": null,\n  \"is_suspended\": false,\n  \"created_at\": \"2026-11-24T12:00:00Z\",\n  \"updated_at\": \"2026-11-24T12:05:00Z\"\n}"
                }
