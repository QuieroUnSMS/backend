{
  "info": {
    "_postman_id": "quierounsms-backend-api",
    "name": "QuieroUnSMS Backend API",
    "description": "Postman Collection v2.1 for the QuieroUnSMS backend. Keep in sync with repository-root [openapi.yaml](openapi.yaml) (OpenAPI **0.2.0**).\n\n**Auth**: `POST /session` stores `session_token` in collection variables. All `/me/*` routes use collection Bearer auth (`{{session_token}}`).\n\n**Operations**: `bootstrapSession`, `getCurrentIdentity`, `registerCurrentIdentity`, `addComplementaryContact`, `getCheckoutState`, `putCheckoutState`, `listPurchaseHistory`, `appendPurchaseHistory`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "0.2.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{session_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "session_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Session",
      "description": "`POST /session` — operationId: `bootstrapSession`",
      "item": [
        {
          "name": "bootstrapSession — new guest",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/session",
            "description": "No bearer: issues a new guest identity. Expect **201** and `identity.registration_status` = `guest`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.session_token) {",
                  "    pm.collectionVariables.set('session_token', body.session_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "201 New guest",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"session_token\": \"opaque-token-example\",\n  \"identity\": {\n    \"id\": \"00000000-0000-4000-8000-000000000010\",\n    \"registration_status\": \"guest\",\n    \"email\": null,\n    \"phone_e164\": null,\n    \"is_suspended\": false,\n    \"created_at\": \"2026-11-24T12:00:00Z\",\n    \"updated_at\": \"2026-11-24T12:00:00Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "bootstrapSession — resume existing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/session",
            "description": "Valid collection bearer: expect **200** when the credential is recognized."
          },
          "response": [
            {
              "name": "200 Session recognized",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"session_token\": \"opaque-token-example\",\n  \"identity\": {\n    \"id\": \"00000000-0000-4000-8000-000000000010\",\n    \"registration_status\": \"guest\",\n    \"email\": null,\n    \"phone_e164\": null,\n    \"is_suspended\": false,\n    \"created_at\": \"2026-11-24T12:00:00Z\",\n    \"updated_at\": \"2026-11-24T12:00:00Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "bootstrapSession — invalid bearer",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-token",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/session",
            "description": "Unknown token on bootstrap. Expect **401**."
          },
          "response": [
            {
              "name": "401 Invalid bearer",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"detail\": \"Sesión no válida o ausente\"\n}"
            }
          ]
        }
      ]
    },
    {
