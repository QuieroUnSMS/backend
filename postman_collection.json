        {
          "name": "Quickstart flow (ordered)",
          "description": "Run top-to-bottom after starting the API ([quickstart.md](specs/002-user-registration/quickstart.md)).",
          "item": [
            {
              "name": "1 — Bootstrap guest session",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/session"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('guest session issued', function () {",
                      "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.identity.registration_status).to.eql('guest');",
                      "  pm.collectionVariables.set('session_token', body.session_token);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "response": []
            },
            {
              "name": "2 — Save checkout state",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"state\": {\n    \"step\": \"payment\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/me/checkout-state"
              },
              "response": []
            },
            {
              "name": "3 — Append purchase history",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"summary\": \"Test purchase\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/me/purchase-history"
              },
              "response": []
            },
            {
              "name": "4 — Register with email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"buyer@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/me/registration"
              },
              "response": []
            },
            {
              "name": "5 — Add complementary phone",
              "request": {
                "method": "PATCH",
                "header": [
