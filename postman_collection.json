    {
      "name": "Quickstart flow",
      "description": "Ordered manual acceptance aligned with [specs/001-user-registration/quickstart.md](specs/001-user-registration/quickstart.md) and `openapi.yaml`.",
      "item": [
        {
          "name": "1 — bootstrapSession (guest)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('guest session issued', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.identity.registration_status).to.eql('guest');",
                  "  pm.collectionVariables.set('session_token', body.session_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2 — putCheckoutState",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": {\n    \"step\": \"payment\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/me/checkout-state"
          },
          "response": []
        },
        {
          "name": "3 — appendPurchaseHistory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
