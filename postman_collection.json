                "url": "{{baseUrl}}/me/registration",
                "description": "US2 — Guest upgrades with E.164 phone (leading `+`). Expect `200` when phone is unique."
              },
              "response": [
                {
                  "name": "200 Registered",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\n  \"id\": \"00000000-0000-4000-8000-000000000010\",\n  \"registration_status\": \"registered\",\n  \"email\": null,\n  \"phone_e164\": \"+525551234567\",\n  \"is_suspended\": false,\n  \"created_at\": \"2026-11-24T12:00:00Z\",\n  \"updated_at\": \"2026-11-24T12:05:00Z\"\n}"
                }
              ]
            },
            {
              "name": "Upgrade conflict (example email taken)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"already-taken@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/me/registration",
                "description": "US2 — Second guest attempts taken email. Expect `409`; guest remains guest."
              },
              "response": [
                {
                  "name": "409 Conflict",
                  "status": "Conflict",
                  "code": 409,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\n  \"detail\": \"Email already in use\"\n}"
                }
              ]
            }
          ]
