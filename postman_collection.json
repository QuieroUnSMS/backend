            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Test purchase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/me/purchase-history"
          },
          "response": []
        },
        {
          "name": "4 — getCheckoutState",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/checkout-state"
          },
          "response": []
        },
        {
          "name": "5 — listPurchaseHistory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/purchase-history"
          },
          "response": []
        },
        {
          "name": "6 — registerCurrentIdentity (email)",
          "request": {
            "method": "POST",
