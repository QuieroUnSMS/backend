{
  "info": {
    "_postman_id": "quierounsms-backend-api",
    "name": "QuieroUnSMS Backend API",
    "description": "Canonical Postman collection for the QuieroUnSMS backend. Import at repository root.\n\n**Auth**: After `POST /session`, the collection stores `session_token` automatically. Protected `/me/*` routes use Bearer auth via collection variables.\n\n**Feature**: `002-user-registration` — guest-first identity, optional registration, checkout and purchase placeholders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{session_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "session_token",
      "value": ""
    },
    {
      "key": "contact_id",
      "value": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "002-user-registration",
      "description": "Guest-first identity and optional registration ([specs/002-user-registration/spec.md](specs/002-user-registration/spec.md)).",
      "item": [
        {
          "name": "Session",
          "item": [
            {
              "name": "Bootstrap session (new guest)",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/session",
                "description": "US1 — Issue a new guest identity when no valid bearer is sent. Expect `201` and `identity.registration_status` = `guest`."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201 || pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.session_token) {",
                      "    pm.collectionVariables.set('session_token', body.session_token);",
                      "  }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "response": [
                {
                  "name": "201 New guest",
                  "status": "Created",
                  "code": 201,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\n  \"session_token\": \"opaque-token-example\",\n  \"identity\": {\n    \"id\": \"00000000-0000-4000-8000-000000000010\",\n    \"registration_status\": \"guest\",\n    \"email\": null,\n    \"phone_e164\": null,\n    \"is_suspended\": false,\n    \"created_at\": \"2026-11-24T12:00:00Z\",\n    \"updated_at\": \"2026-11-24T12:00:00Z\"\n  }\n}"
                }
              ]
            },
            {
              "name": "Bootstrap session (resume existing)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/session",
                "description": "US1 — Present stored `session_token` via collection Bearer auth. Expect `200` when the credential is valid."
              },
              "response": [
                {
                  "name": "200 Session recognized",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\n  \"session_token\": \"opaque-token-example\",\n  \"identity\": {\n    \"id\": \"00000000-0000-4000-8000-000000000010\",\n    \"registration_status\": \"guest\",\n    \"email\": null,\n    \"phone_e164\": null,\n    \"is_suspended\": false,\n    \"created_at\": \"2026-11-24T12:00:00Z\",\n    \"updated_at\": \"2026-11-24T12:00:00Z\"\n  }\n}"
                }
              ]
            }
          ]
        },
        {
          "name": "Profile",
          "item": [
            {
              "name": "Get current identity",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/me",
                "description": "US2/US3 — Current identity profile. Requires Bearer session."
              },
              "response": [
                {
                  "name": "200 Profile",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\n  \"id\": \"00000000-0000-4000-8000-000000000010\",\n  \"registration_status\": \"registered\",\n  \"email\": \"buyer@example.com\",\n  \"phone_e164\": \"+525512345678\",\n  \"is_suspended\": false,\n  \"created_at\": \"2026-11-24T12:00:00Z\",\n  \"updated_at\": \"2026-11-24T12:05:00Z\"\n}"
                }
              ]
